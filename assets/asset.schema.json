{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixecreator.local/schemas/asset.schema.json",
  "title": "Pixel asset manifest (frozen v1, task 3.2)",
  "type": "object",
  "required": ["id", "asset", "kind", "use", "size", "palette", "seed", "perspectives", "views", "masters", "actions", "preview"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "asset": { "type": "string", "pattern": "^[a-z0-9]+$", "description": "Short file-name prefix; clip files are {asset}_{td|sd}_{action}_{dir}{N}.svg" },
    "kind": { "const": "character" },
    "use": { "const": "2d-rpg" },
    "size": { "enum": [32, 48, 64] },
    "palette": { "type": "string", "pattern": "^palette_character@v[0-9]+$" },
    "seed": { "type": "integer" },
    "perspectives": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "enum": ["td", "sd"] }
    },
    "views": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "enum": ["fr", "bk", "lf", "rt"] }
    },
    "masters": {
      "type": "object",
      "required": ["td", "sd"],
      "additionalProperties": false,
      "properties": {
        "td": { "type": "string", "pattern": "\\.svg$" },
        "sd": { "type": "string", "pattern": "\\.svg$" }
      }
    },
    "actions": {
      "type": "object",
      "required": ["idle", "walk", "attack"],
      "additionalProperties": false,
      "properties": {
        "idle": { "$ref": "#/$defs/action" },
        "walk": { "$ref": "#/$defs/action" },
        "attack": { "$ref": "#/$defs/action" }
      }
    },
    "preview": {
      "type": "object",
      "required": ["perspective", "action", "dir"],
      "additionalProperties": false,
      "properties": {
        "perspective": { "enum": ["td", "sd"] },
        "action": { "enum": ["idle", "walk", "attack"] },
        "dir": { "enum": ["fr", "bk", "lf", "rt"] }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["frames", "fps", "loop", "clips"],
      "additionalProperties": false,
      "properties": {
        "frames": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" },
        "next": { "type": "string" },
        "clips": {
          "type": "object",
          "required": ["td", "sd"],
          "additionalProperties": false,
          "properties": {
            "td": { "$ref": "#/$defs/dirClips" },
            "sd": { "$ref": "#/$defs/dirClips" }
          }
        }
      }
    },
    "dirClips": {
      "type": "object",
      "required": ["fr", "bk", "lf", "rt"],
      "additionalProperties": false,
      "properties": {
        "fr": { "$ref": "#/$defs/frameList" },
        "bk": { "$ref": "#/$defs/frameList" },
        "lf": { "$ref": "#/$defs/frameList" },
        "rt": { "$ref": "#/$defs/frameList" }
      }
    },
    "frameList": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "$ref": "#/$defs/frame" }
    },
    "frame": {
      "type": "object",
      "required": ["file", "seed", "prompt_hash"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z0-9_]+_(td|sd)_(idle|walk|attack)_(fr|bk|lf|rt)[0-9]+\\.svg$" },
        "seed": { "type": "integer" },
        "prompt_hash": { "type": "string", "minLength": 6 },
        "denoise": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
